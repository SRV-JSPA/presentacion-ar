/* Íconos en SVG (24×24) que imitan los SF Symbols que usa la app, y los cuatro íconos
   dibujados del menú (App/UICoordinator/MenuIcons.swift, coordenadas exactas).

     Iconos.svg('play.fill')                 → <svg class="icono">…</svg>, color = currentColor
     Iconos.svg('arrow.uturn.left', 'clase') → con clase extra
     Iconos.menu('guiado' | 'libre' | 'instrucciones' | 'terminos')  → a color, como en la app
     Object.keys(Iconos.todos)               → la lista

   Los rellenos y trazos van en currentColor; los huecos (el check dentro del círculo, la cruz del
   control) se recortan con una máscara, así se ve lo que hay detrás, como en iOS. */
window.Iconos = (function () {
  'use strict';
  var T = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
  var F = 'fill="currentColor"';
  /* Huecos de máscara: se pintan en negro dentro de la máscara */
  var HT = 'fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"';
  var HF = 'fill="#000"';

  var todos = {
    'arrow.uturn.left': { c: '<path ' + T + ' d="M9 14 4 9l5-5"/><path ' + T + ' d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>' },
    'arrow.uturn.backward': { c: '<path ' + T + ' d="M9 14 4 9l5-5"/><path ' + T + ' d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>' },
    'info': { c: '<circle ' + F + ' cx="12.2" cy="5.6" r="1.6"/><path ' + T + ' d="M9.8 10h2.6v9"/><path ' + T + ' d="M9.4 19h6"/>' },
    'info.circle': { c: '<circle ' + T + ' cx="12" cy="12" r="9.2"/><circle ' + F + ' cx="12" cy="7.7" r="1.25"/><path ' + T + ' stroke-width="1.8" d="M10.4 11h1.8v5.6M10 16.6h4.4"/>' },
    'play.fill': { c: '<path ' + F + ' d="M7.5 5.3v13.4a1.1 1.1 0 0 0 1.68.93l10.4-6.7a1.1 1.1 0 0 0 0-1.86L9.18 4.37A1.1 1.1 0 0 0 7.5 5.3Z"/>' },
    'forward.end.fill': { c: '<path ' + F + ' d="M4.5 5.6v12.8a1 1 0 0 0 1.56.83l9.5-6.4a1 1 0 0 0 0-1.66l-9.5-6.4A1 1 0 0 0 4.5 5.6Z"/><rect ' + F + ' x="16.6" y="4.8" width="2.9" height="14.4" rx="1.1"/>' },
    'checkmark': { c: '<path ' + T + ' d="M4.8 12.6 9.6 17.4 19.4 6.8"/>' },
    'xmark': { c: '<path ' + T + ' d="M6 6l12 12M18 6 6 18"/>' },
    'chevron.left': { c: '<path ' + T + ' d="M14.5 5.5 8 12l6.5 6.5"/>' },
    'text.bubble': { c: '<path ' + T + ' stroke-width="1.8" d="M5.2 4h13.6A2.2 2.2 0 0 1 21 6.2v8.6a2.2 2.2 0 0 1-2.2 2.2h-5.6L9 20.4V17H5.2A2.2 2.2 0 0 1 3 14.8V6.2A2.2 2.2 0 0 1 5.2 4Z"/><path ' + T + ' stroke-width="1.8" d="M7.6 8.6h8.8M7.6 12.2h5.6"/>' },
    'text.bubble.fill': { c: '<path ' + F + ' d="M5.2 4h13.6A2.2 2.2 0 0 1 21 6.2v8.6a2.2 2.2 0 0 1-2.2 2.2h-5.6L9 20.4V17H5.2A2.2 2.2 0 0 1 3 14.8V6.2A2.2 2.2 0 0 1 5.2 4Z"/>',
      m: '<path ' + HT + ' stroke-width="1.8" d="M7.6 8.6h8.8M7.6 12.2h5.6"/>' },
    'map.fill': { c: '<path ' + F + ' d="M3 6.4 7.8 4.5v13.4L3 19.8Z"/><path ' + F + ' d="M9.4 4.5l5.2 2v13.4l-5.2-2Z"/><path ' + F + ' d="M16.2 6.5 21 4.6V18l-4.8 1.9Z"/>' },
    'map': { c: '<path ' + T + ' stroke-width="1.8" d="M3 6.4 8.6 4.3l6.8 2.4L21 4.6V17.6l-5.6 2.1-6.8-2.4L3 19.4Z"/><path ' + T + ' stroke-width="1.8" d="M8.6 4.3v13M15.4 6.7v13"/>' },
    'play.rectangle.fill': { c: '<rect ' + F + ' x="2" y="5" width="20" height="14" rx="3"/>', m: '<path ' + HF + ' d="M10 8.6v6.8l5.8-3.4Z"/>' },
    'figure.walk': { c: '<circle ' + F + ' cx="13.6" cy="3.9" r="2.1"/><path ' + T + ' stroke-width="2.3" d="M12.8 7.8 10.9 13.4M10.9 13.4 8.2 20.6M10.9 13.4l3.3 3 -.5 4.7M12.6 8.3l3.4 3.1 2.4.3M12.4 8.4 9 10.3l-.9 2.8"/>' },
    'checkmark.circle.fill': { c: '<circle ' + F + ' cx="12" cy="12" r="10"/>', m: '<path ' + HT + ' d="M7.4 12.3l3.1 3.1 6.1-6.6"/>' },
    'location.north.fill': { c: '<path ' + F + ' d="M12 2.6 19.6 21.2 12 17 4.4 21.2Z"/>' },
    'location.circle.fill': { c: '<circle ' + F + ' cx="12" cy="12" r="10"/>', m: '<path ' + HF + ' d="M12 5.8 16.4 17 12 14.6 7.6 17Z"/>' },
    'mappin': { c: '<path ' + T + ' stroke-width="1.8" d="M12 21.6s6.6-5.9 6.6-11.4a6.6 6.6 0 0 0-13.2 0c0 5.5 6.6 11.4 6.6 11.4Z"/><circle ' + T + ' stroke-width="1.8" cx="12" cy="10" r="2.4"/>' },
    'mappin.circle.fill': { c: '<circle ' + F + ' cx="12" cy="12" r="10"/>', m: '<path ' + HF + ' d="M12 18.4s4.3-3.7 4.3-7.3a4.3 4.3 0 0 0-8.6 0c0 3.6 4.3 7.3 4.3 7.3Z"/><circle fill="#fff" cx="12" cy="11" r="1.5"/>' },
    'hand.tap': { c: '<path ' + T + ' stroke-width="1.7" d="M6.6 5.6a5.2 5.2 0 0 1 7.8 0"/><path ' + T + ' stroke-width="1.7" d="M9.2 13.2V7.8a1.5 1.5 0 0 1 3 0v4.4M12.2 11.4a1.5 1.5 0 0 1 3 0v1.2M15.2 12a1.5 1.5 0 0 1 3 0v2.6c0 3.7-2.6 6.4-6 6.4h-.7c-1.9 0-3.4-.8-4.5-2.4l-2.4-3.4a1.5 1.5 0 0 1 2.4-1.8l2.2 2.2"/>' },
    'hand.tap.fill': { c: '<path ' + T + ' stroke-width="1.7" d="M6.6 5.6a5.2 5.2 0 0 1 7.8 0"/><path ' + F + ' d="M9.2 7.8a1.5 1.5 0 0 1 3 0v3.4a1.5 1.5 0 0 1 3 .2 1.5 1.5 0 0 1 3 .6v2.6c0 3.7-2.6 6.4-6 6.4h-.7c-1.9 0-3.4-.8-4.5-2.4l-2.4-3.4a1.5 1.5 0 0 1 2.4-1.8l2.2 2.2Z"/>' },
    'gamecontroller.fill': { c: '<path ' + F + ' d="M7.4 6.6h9.2c2.7 0 4.4 2 4.8 4.9l.8 5.3c.3 2.1-1.9 3.5-3.5 2.2l-2.4-2.2H7.7l-2.4 2.2c-1.6 1.3-3.8-.1-3.5-2.2l.8-5.3C3 8.6 4.7 6.6 7.4 6.6Z"/>',
      m: '<path ' + HT + ' stroke-width="1.6" d="M7.6 9.8v4M5.6 11.8h4"/><circle ' + HF + ' cx="15.6" cy="10.6" r="1.15"/><circle ' + HF + ' cx="17.8" cy="12.8" r="1.15"/>' },
    'gamecontroller': { c: '<path ' + T + ' stroke-width="1.7" d="M7.4 6.6h9.2c2.7 0 4.4 2 4.8 4.9l.8 5.3c.3 2.1-1.9 3.5-3.5 2.2l-2.4-2.2H7.7l-2.4 2.2c-1.6 1.3-3.8-.1-3.5-2.2l.8-5.3C3 8.6 4.7 6.6 7.4 6.6Z"/><path ' + T + ' stroke-width="1.6" d="M7.6 9.8v4M5.6 11.8h4"/><circle ' + F + ' cx="15.6" cy="10.6" r="1.1"/><circle ' + F + ' cx="17.8" cy="12.8" r="1.1"/>' },
    'lock': { c: '<rect ' + T + ' x="5" y="10.5" width="14" height="10" rx="2.2"/><path ' + T + ' d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"/>' },
    'lock.fill': { c: '<rect ' + F + ' x="5" y="10.5" width="14" height="10" rx="2.2"/><path ' + T + ' d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"/>' },
    'lock.open': { c: '<rect ' + T + ' x="5" y="10.5" width="14" height="10" rx="2.2"/><path ' + T + ' d="M8 10.5V7.6a4 4 0 0 1 7.7-1.6"/>' },
    'lock.open.fill': { c: '<rect ' + F + ' x="5" y="10.5" width="14" height="10" rx="2.2"/><path ' + T + ' d="M8 10.5V7.6a4 4 0 0 1 7.7-1.6"/>' },
    'flag.fill': { c: '<path ' + T + ' d="M5.5 21V3.5"/><path ' + F + ' d="M6.5 4h11.2l-2.6 4 2.6 4H6.5Z"/>' },
    'arrow.right': { c: '<path ' + T + ' d="M4.5 12h15M13.5 6l6 6-6 6"/>' },
    'point.topleft.down.to.point.bottomright.curvepath': { c: '<circle ' + F + ' cx="5" cy="5" r="2.4"/><circle ' + F + ' cx="19" cy="19" r="2.4"/><path ' + T + ' stroke-dasharray="2 3" d="M6.5 7.5c3 4 1 6 5.5 7.5s4.5 1 5.5 2"/>' }
  };

  var n = 0;
  function svg(nombre, clase) {
    var d = todos[nombre];
    if (!d) { try { console.error('[Iconos] no existe: ' + nombre); } catch (e) {} return ''; }
    var cuerpo = d.c;
    if (d.m) {
      var id = 'ic-m' + (++n);
      cuerpo = '<defs><mask id="' + id + '" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect width="24" height="24" fill="#fff"/>' + d.m +
        '</mask></defs><g mask="url(#' + id + ')">' + d.c + '</g>';
    }
    return '<svg class="icono' + (clase ? ' ' + clase : '') + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + cuerpo + '</svg>';
  }

  /* Íconos del menú, dibujados en una cuadrícula de 24×24 (MenuIcons.swift) */
  var P = '#D25B31', O = '#E6B75C', C = '#ECEBC8', Tt = '#E2BF9B';
  var MENU = {
    guiado: '<circle cx="12" cy="12" r="10" fill="' + C + '" stroke="' + P + '" stroke-width="2"/>' +
      '<polygon points="12,6 10,12 12,11 14,12" fill="' + P + '"/><polygon points="12,18 14,12 12,13 10,12" fill="' + O + '"/>' +
      '<circle cx="12" cy="12" r="1.5" fill="' + Tt + '"/>' +
      '<path d="M12 3v2M12 19v2M3 12h2M19 12h2" stroke="' + P + '" stroke-width="1"/>',
    libre: '<rect x="4" y="4" width="16" height="16" fill="' + C + '" stroke="' + P + '" stroke-width="1.5"/>' +
      '<path d="M8 9h8M8 17h8M9 8v8M15 8v8" stroke="' + O + '" stroke-width="1"/>' +
      '<circle cx="8" cy="9" r="1" fill="' + P + '"/><circle cx="16" cy="9" r="1" fill="' + O + '"/>' +
      '<circle cx="8" cy="17" r="1" fill="' + Tt + '"/><circle cx="16" cy="17" r="1" fill="' + P + '"/>',
    instrucciones: '<path d="M6,3 H18 Q20,3 20,5 V19 Q20,21 18,21 H6 Q4,21 4,19 V5 Q4,3 6,3" fill="' + C + '" stroke="' + P + '" stroke-width="1.5"/>' +
      '<path d="M7 7h10M7 10h8M7 13h10M7 16h6" stroke="' + O + '" stroke-width="1.5"/><circle cx="15" cy="16" r="1" fill="' + P + '"/>',
    terminos: '<polygon points="5,2 15,2 19,6 19,22 5,22" fill="' + C + '" stroke="' + P + '" stroke-width="1.5" stroke-linejoin="round"/>' +
      '<path d="M15 2v4h4" fill="' + Tt + '" stroke="' + P + '" stroke-width="1"/>' +
      '<circle cx="12" cy="15" r="3" fill="' + P + '"/><circle cx="12" cy="15" r="1.5" fill="' + C + '"/>' +
      '<path d="M10.5 15h3M12 13.5v3" stroke="' + O + '" stroke-width=".5"/><path d="M7 9h6M7 20h10" stroke="' + O + '" stroke-width="1"/>'
  };
  function menu(nombre, clase) {
    var d = MENU[nombre];
    if (!d) { try { console.error('[Iconos] no existe el ícono de menú: ' + nombre); } catch (e) {} return ''; }
    return '<svg class="icono icono--menu' + (clase ? ' ' + clase : '') + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + d + '</svg>';
  }

  return { svg: svg, menu: menu, todos: todos };
})();
