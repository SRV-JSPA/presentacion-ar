/* 19 · Cierre — ink. A la izquierda, el video del recorrido desde YouTube (https://youtu.be/9a-eQT1gBiw),
   con audio y en bucle: se carga al entrar y se descarga al salir (así deja de sonar). Debajo del teléfono, el enlace al video. La guía virtual aparece con la línea
   de escaneo y dice su despedida (VideoTranscripts.swift:165-171), palabra por palabra.
   «Gracias.» y «¿Preguntas?». Antes aquí estaba la Acrópolis (Monticulo12.obj) en el visor 3D. */
(function () {
  var YT = '9a-eQT1gBiw', marco = null;
  var EMBED = 'https://www.youtube-nocookie.com/embed/' + YT + '?autoplay=1&mute=0&loop=1&playlist=' + YT + '&controls=0&modestbranding=1&rel=0&playsinline=1';
  var CITA = 'Ha sido para mí un gusto ser tu guía el día de hoy.';

  function palabras(t) {
    var w = t.split(' ');
    return w.map(function (p, i) {
      return '<span class="cierre__w" style="--i:' + i + '">' + (i === 0 ? '«' : '') + p + (i === w.length - 1 ? '»' : '') + '</span>';
    }).join(' ');
  }

  Presentacion.diapositiva({
    id: 'cierre',
    titulo: 'Gracias',
    seccion: 'Cierre',
    tema: 'ink',
    transicion: 'iris',
    resumen: 'La guía se despide; preguntas',
    html: `
      <div class="lienzo cierre">
        <div class="cierre__marco" data-decorativo>
          <div class="cierre__tel">
            <a class="cierre__tel-enlace" href="https://youtu.be/9a-eQT1gBiw" target="_blank" rel="noopener"
               title="Ver el video en YouTube" aria-label="Ver el video del recorrido en YouTube">
              <div class="telefono" data-ui="oscura" style="--ancho:clamp(230px,25vw,300px)">
                <div class="telefono__pantalla">
                  <div class="pantalla cierre__pantalla" data-ancho="390" data-alto="844"></div>
                </div>
              </div>
            </a>
            <a class="cierre__enlace" href="https://youtu.be/9a-eQT1gBiw" target="_blank" rel="noopener">▶ youtu.be/9a-eQT1gBiw</a>
          </div>
        </div>

        <figure class="cierre__guia" aria-hidden="true">
          <div class="cierre__guia-caja">
            <img src="./AR Tour Kaminaljuyú · Realidad aumentada_files/guia-despedida.png" alt="">
            ${Motivos.escaneo('cierre__escaneo')}
          </div>
        </figure>

        <div class="cierre__texto">
          ${Deck.cabeza('', 'Gracias.', { clase: 'cierre__cabeza' })}
          <blockquote class="cierre__cita">
            ${Motivos.esquinas()}
            <p class="cierre__frase">${palabras(CITA)}</p>
            <footer class="cierre__autor">La guía virtual, al despedirse</footer>
          </blockquote>
          <p class="cierre__pregunta" data-anim="subir" style="--retraso:2900ms">¿Preguntas?</p>
          <p class="cierre__pie" data-anim="aparecer" style="--retraso:3300ms">AR Tour Kaminaljuyú · Universidad del Valle de Guatemala · 2026</p>
        </div>
      </div>
    `,
    alEntrar: function (el) {
      marco = el.querySelector('.cierre__pantalla');
      if (!marco || Deck.quieto() || marco.querySelector('iframe')) return;
      var f = document.createElement('iframe');
      f.className = 'cierre__video';
      f.src = EMBED;
      f.title = 'Video del recorrido AR Tour Kaminaljuyú';
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.setAttribute('tabindex', '-1');
      marco.appendChild(f);
    },
    /* al salir se quita el iframe para que el video deje de sonar y de consumir datos */
    alSalir: function () { if (marco) { var f = marco.querySelector('iframe'); if (f) f.remove(); } }
  });
})();
