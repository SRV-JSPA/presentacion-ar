              var mx = (s[0] + s[2]) / 2, mz = (s[1] + s[3]) / 2, r = Math.hypot(mx, mz);
              var f = 1 - clamp((r - geo.R * .45) / (geo.R * 1.15), 0, 1);
              if (f <= 0) return;
