          if (dibujarSolido && h <= yc) continue;
          curva(j, Math.min(h, yc));
        }
      }
      /* plano de escaneo */
      if (campos.plano > .001 && campos.corte > 0 && campos.corte < 1) {
        var S = geo.R * 1.25, esq = [[-S, -S], [S, -S], [S, S], [-S, S]];
        c.beginPath();
        esq.forEach(function (e, n) { proyectar(e[0], yc, e[1], tmp, 0); if (n) c.lineTo(tmp[0], tmp[1]); else c.moveTo(tmp[0], tmp[1]); });
        c.closePath();
