      cancelar();
      if (quieto()) return final(o);
      ahora({ corte: 0, dibujo: 0, curvas: 1, bajo: .32, alambre: 0, brillo: 0, plano: 0, suelo: 0 });
      estado({ suelo: 1 }, { ms: 1100 * f, retraso: r });
      estado({ dibujo: 1 }, { ms: 1700 * f, retraso: r + 150 * f, curva: 'suave' });
      estado({ brillo: 1, plano: 1 }, { ms: 500 * f, retraso: r + 1500 * f });
      estado({ corte: 1 }, { ms: 2900 * f, retraso: r + 1650 * f, curva: 'escaneo' });
      estado({ alambre: o.alambre == null ? 1 : o.alambre }, { ms: 1300 * f, retraso: r + 3900 * f, curva: 'suave' });
      estado({ brillo: 0, plano: 0, curvas: o.curvas == null ? 0 : o.curvas }, { ms: 1100 * f, retraso: r + 4300 * f, curva: 'suave', alFin: o.alFin });
      return api;
    }
    function final(o) {
      o = o || {};
      cancelar();
      ahora({ corte: 1, dibujo: 1, curvas: o.curvas == null ? 0 : o.curvas, bajo: .32, alambre: o.alambre == null ? 1 : o.alambre,
        brillo: 0, plano: 0, suelo: op.suelo === false ? 0 : 1, armar: 1, opacidad: 1 });
      if (!activo) { if (pendiente) { cancelAnimationFrame(pendiente); pendiente = 0; } dibujar(); }
      if (o.alFin) o.alFin();
      return api;
    }

    /* ── Gestos: arrastrar gira e inclina; rueda o pellizco escala (0,1× a 5×, como la app) ── */
    var arrastre = null, punteros = {};
    if (op.interactivo !== false) {
      canvas.style.touchAction = 'pan-y';
      canvas.addEventListener('pointerdown', function (e) {
        punteros[e.pointerId] = { x: e.clientX, y: e.clientY };
        try { canvas.setPointerCapture(e.pointerId); } catch (er) {}
        var ids = Object.keys(punteros);
        if (ids.length === 1) arrastre = { x: e.clientX, y: e.clientY, giro: campos.giro, incl: campos.inclinacion };
        else if (ids.length === 2 && op.escalar) {
          var a = punteros[ids[0]], b = punteros[ids[1]];
          arrastre = { pellizco: Math.hypot(a.x - b.x, a.y - b.y), zoom: campos.zoom };
        }
        host.classList.add('visor--arrastrando');
      });
      canvas.addEventListener('pointermove', function (e) {
        if (!punteros[e.pointerId] || !arrastre) return;
        punteros[e.pointerId] = { x: e.clientX, y: e.clientY };
        if (arrastre.pellizco) {
          var ids = Object.keys(punteros); if (ids.length < 2) return;
          var a = punteros[ids[0]], b = punteros[ids[1]];
          campos.zoom = clamp(arrastre.zoom * Math.hypot(a.x - b.x, a.y - b.y) / Math.max(1, arrastre.pellizco), .1, 5);
        } else {
          campos.giro = arrastre.giro + (e.clientX - arrastre.x) * .009;
          campos.inclinacion = clamp(arrastre.incl + (e.clientY - arrastre.y) * .006, .06, 1.35);
        }
        dibujarLuego();
      });
      var soltar = function (e) {
        delete punteros[e.pointerId];
        if (!Object.keys(punteros).length) { arrastre = null; pausaGiro = 1.6; factorGiro = 0; host.classList.remove('visor--arrastrando'); }
      };
      canvas.addEventListener('pointerup', soltar);
      canvas.addEventListener('pointercancel', soltar);
      if (op.escalar) {
        canvas.addEventListener('wheel', function (e) {
          e.preventDefault(); e.stopPropagation();
          campos.zoom = clamp(campos.zoom * Math.exp(-e.deltaY * .0015), .1, 5);
          dibujarLuego();
        }, { passive: false });
      }
    }

    function destruir() {
      detener(); cancelar();
      if (obs) obs.disconnect();
      if (gl) { var ext = gl.getExtension('WEBGL_lose_context'); if (ext) ext.loseContext(); }
      if (canvas.parentNode) canvas.parentNode.removeChild(canvas);
    }

    var api = {
      medir: medir, dibujar: dibujar, iniciar: iniciar, detener: detener, ahora: ahora, estado: estado, cancelar: cancelar,
      revelar: revelar, final: final, destruir: destruir,
      get campos() { return campos; }, get canvas() { return canvas; }, get webgl() { return !!gl; },
      get velocidad() { return velocidad; }, set velocidad(v) { velocidad = v; },
      get activo() { return activo; }, geometria: geo, host: host
    };
    instancias.push(api);
    return api;
  }

  /* instancias: todos los visores creados (útil para revisar desde la consola) */
  var instancias = [];
  return { crear: crear, geometria: geometria, curvas: CURVAS, instancias: instancias };
})();
