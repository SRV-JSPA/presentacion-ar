          proyectar(u, yc, -S, tmp, 0); c.beginPath(); c.moveTo(tmp[0], tmp[1]); proyectar(u, yc, S, tmp, 0); c.lineTo(tmp[0], tmp[1]); c.stroke();
          proyectar(-S, yc, u, tmp, 0); c.beginPath(); c.moveTo(tmp[0], tmp[1]); proyectar(S, yc, u, tmp, 0); c.lineTo(tmp[0], tmp[1]); c.stroke();
        }
