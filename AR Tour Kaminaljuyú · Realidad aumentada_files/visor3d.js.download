        proyectar(0, 0, 0, tmp, 0); var c0x = tmp[0], c0y = tmp[1];
        proyectar(geo.R, 0, 0, tmp, 0); var rx = Math.hypot(tmp[0] - c0x, tmp[1] - c0y);
        proyectar(0, 0, geo.R, tmp, 0); var rz = Math.hypot(tmp[0] - c0x, tmp[1] - c0y);
        var rr = Math.max(rx, rz) * 1.08, g = c.createRadialGradient(c0x, c0y, 0, c0x, c0y, rr);
        g.addColorStop(0, 'rgba(0,0,0,' + (colores.sombra * campos.suelo) + ')'); g.addColorStop(1, 'rgba(0,0,0,0)');
        c.save(); c.translate(c0x, c0y); c.scale(1, Math.min(rx, rz) / Math.max(rx, rz)); c.translate(-c0x, -c0y);
        c.fillStyle = g; c.beginPath(); c.arc(c0x, c0y, rr, 0, Math.PI * 2); c.fill(); c.restore();
