    }
    var obs = window.ResizeObserver ? new ResizeObserver(function () { medir(); }) : null;
    if (obs) obs.observe(canvas);

    /* ── Bucle y animación ── */
    var activo = false, idBucle = 0, previo = 0, pausaGiro = 0, factorGiro = 1, tweens = [], idTween = 0, pendiente = 0;
    function cuadro(ts) {
