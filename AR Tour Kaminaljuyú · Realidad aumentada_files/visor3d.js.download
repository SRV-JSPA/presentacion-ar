        idx.forEach(function (v) { if (P[3 * v + 1] > yc) fuera++; });
        if (!fuera) return [scr[3 * idx[0]], scr[3 * idx[0] + 1], scr[3 * idx[1]], scr[3 * idx[1] + 1], scr[3 * idx[2]], scr[3 * idx[2] + 1]];
        var out = [];
