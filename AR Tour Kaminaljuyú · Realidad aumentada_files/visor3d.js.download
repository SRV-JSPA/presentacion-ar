            });
          }
        }
        c.globalAlpha = 1;
      }
      /* curvas que todavía viajan con el escaneo (o todas, si no hay sólido) */
      if (campos.curvas > .001 && campos.dibujo > 0) {
        c.lineWidth = grosorCurvas;
        c.strokeStyle = css(oro, colores.curvas * campos.curvas);
        for (var j = 0; j < corte.n; j++) {
          if (corte.__orden[j] > campos.dibujo) continue;
