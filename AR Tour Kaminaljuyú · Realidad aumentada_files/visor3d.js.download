      if (gl) { if (gl.isContextLost()) return; dibujarGL(); } else dibujar2D();
    }

    /* ── Tamaño ── */
    function medir() {
      var w = canvas.offsetWidth || host.offsetWidth, h = canvas.offsetHeight || host.offsetHeight;
      if (!w || !h) return false;
      var d = Math.min(2, window.devicePixelRatio || 1);
      if (w === ancho && h === alto && d === dpr) return false;
      ancho = w; alto = h; dpr = d;
      canvas.width = Math.round(w * d); canvas.height = Math.round(h * d);
