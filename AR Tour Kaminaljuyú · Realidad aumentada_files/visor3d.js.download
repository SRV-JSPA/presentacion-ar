      var scr = k2.scr;
      for (i = 0; i < geo.nV; i++) proyectar(P[3 * i], P[3 * i + 1], P[3 * i + 2], scr, 3 * i);
      /* triángulos visibles, de lejos a cerca */
      var n2 = 0, t = geo.t;
      var dibujarSolido = campos.corte > 0 && campos.armar > 0 && campos.opacidad > .001;
      if (dibujarSolido) {
        for (i = 0; i < geo.nT; i++) {
          if (geo.triO[i] > campos.armar) continue;
          var a = t[3 * i], b = t[3 * i + 1], d = t[3 * i + 2];
          if (P[3 * a + 1] > yc && P[3 * b + 1] > yc && P[3 * d + 1] > yc) continue;
          k2.prof[i] = scr[3 * a + 2] + scr[3 * b + 2] + scr[3 * d + 2];
          k2.orden[n2++] = i;
        }
        var ord = Array.prototype.slice.call(k2.orden.subarray(0, n2));
        ord.sort(function (x, y) { return k2.prof[y] - k2.prof[x]; });
        c.globalAlpha = campos.opacidad;
        var aA = colores.alambre * campos.alambre * Math.min(1, campos.armar * 1.5);
        var aC = colores.curvas * campos.curvas * campos.bajo;
        for (var q = 0; q < ord.length; q++) {
          i = ord[q];
          var poli = poligono(i, yc);
          if (!poli) continue;
          /* sombreado plano */
          var nx = geo.triN[3 * i], ny = geo.triN[3 * i + 1], nz = geo.triN[3 * i + 2];
          var ia = t[3 * i], ib = t[3 * i + 1], ic = t[3 * i + 2];
          var ex1 = scr[3 * ib] - scr[3 * ia], ey1 = scr[3 * ib + 1] - scr[3 * ia + 1], ex2 = scr[3 * ic] - scr[3 * ia], ey2 = scr[3 * ic + 1] - scr[3 * ia + 1];
          if (ex1 * ey2 - ey1 * ex2 > 0) { nx = -nx; ny = -ny; nz = -nz; }
