    /* ── Dibujo 2D (respaldo): el mismo modelo, por pintor ── */
    var cache2 = null;
    function preparar2D() {
      if (cache2) return cache2;
      var porTri = new Array(geo.nT), al = rng(5);
      for (var j = 0; j < corte.n; j++) {
        var ang = (Math.atan2(corte.seg[4 * j + 1] + corte.seg[4 * j + 3], corte.seg[4 * j] + corte.seg[4 * j + 2]) / (Math.PI * 2) + 1) % 1;
        var o = clamp(.04 + .66 * corte.k[j] / Math.max(1, niveles - 1) + .26 * ang + al() * .03, 0, 1);
        (porTri[corte.tri[j]] = porTri[corte.tri[j]] || []).push(j);
